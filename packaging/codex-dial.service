[Unit]
Description=Corsair dial control for ChatGPT and Codex
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/codex-dial/dial_daemon.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
